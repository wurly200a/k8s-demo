[103.356694, "o", "\u001b[?2026h\u001b[?25l\u001b[38;5;39m\u001b[1;3H \u001b[1m操作 \u001b(B\u001b[m\u001b[38;5;39m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[H──\u001b[1;159H──\u001b(B\u001b[m\u001b[2;1H\u001b[K\u001b[36m\u001b[1m\r\n### 3. 監視用のペインを開く\u001b(B\u001b[m\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[36m\u001b[1m\r\n### 4. Pod を削除してみる\u001b(B\u001b[m\u001b[K\r\n\u001b[K\r\n$ kubectl delete pod demo-web-7ccc8cbd78-c7bdj -n k8s-demo\u001b[K\r\npod \"demo-web-7ccc8cbd78-c7bdj\" deleted\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[36m\u001b[1m\r\n### 5. レプリカ数を変えてみる\u001b(B\u001b[m\u001b[K\r\n\u001b[K\r\n$ kubectl scale deploy demo-web -n k8s-demo --replicas=6\u001b[K\r\ndeployment.apps/demo-web scaled\u001b[K\r\n\u001b[K\r\n$ kubectl scale deploy demo-web -n k8s-demo --replicas=3\u001b[K\r\ndeployment.apps/demo-web scaled\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[36m\u001b[1m\r\n### 6. 後片付け\u001b(B\u001b[m\u001b[K\r\n\u001b[K\r\n$ kubectl delete -f ../manifests/\u001b[K\r\nnamespace \"k8s-demo\" deleted\u001b[K\r\ndeployment.apps \"demo-web\" deleted\u001b[K\r\nservice \"demo-web\" deleted\u001b[K\r\ningress.networking.k8s.io \"demo-web\" deleted\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[?12l\u001b[?25h\u001b[19A\u001b[?2026l"]
