[5.581281, "o", "apiVersion: apps/v1\r\nkind: Deployment\r\nmetadata:\r\n  name: demo-web\r\n  namespace: k8s-demo\r\nspec:\r\n  replicas: 3\r\n  selector:\r\n    matchLabels:\r\n      app: demo-web\r\n  template:\r\n    metadata:\r\n      labels:\r\n        app: demo-web\r\n    spec:\r\n      terminationGracePeriodSeconds: 3\r\n      initContainers:\r\n        - name: init-index\r\n          image: busybox:1.36\r\n          command:\r\n            - sh\r\n            - -c\r\n            - echo \"served by ${POD_NAME} on ${NODE_NAME}\" > /html/index.html\r\n          env:\r\n            - name: POD_NAME\r\n              valueFrom:\u001b[33;1H"]
