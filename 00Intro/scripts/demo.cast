[13.310105, "o", "                fieldRef:\r\n                  fieldPath: metadata.name\r\n            - name: NODE_NAME\r\n              valueFrom:\r\n                fieldRef:\r\n                  fieldPath: spec.nodeName\r\n          volumeMounts:\r\n            - name: html\r\n              mountPath: /html\r\n      containers:\r\n        - name: web\r\n          image: nginx:1.27-alpine\r\n          ports:\r\n            - containerPort: 80\r\n              name: http\r\n          volumeMounts:\r\n            - name: html\r\n              mountPath: /usr/share/nginx/html\r\n              readOnly: true\r\n          readinessProbe:\r\n            httpGet:\r\n              path: /\r\n              port: http\r\n            initialDelaySeconds: 1\r\n            periodSeconds: 2\r\n      volumes:\r\n        - name: html\r\n          emptyDir: {}\r\n\r\n"]
